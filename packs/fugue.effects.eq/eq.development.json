      "type": "filter",
      "config": {
        "filter_type": "lowshelf",
        "cutoff": 100.0,
        "boost": 0.0,
        "q": 0.7071
      }
    },
    {
      "id": "low_shelf_right",
      "type": "filter",
      "config": {
        "filter_type": "lowshelf",
        "cutoff": 100.0,
