{
  "version": "1.0.0",
  "title": "Pulse Study",
  "description": "A quiet 110 Hz pulse with a clean release between gestures.",
  "modules": [
    {
      "id": "clock",
      "type": "clock",
      "config": { "bpm": 96.0, "gate_duration": 0.35 }
    },
    {
      "id": "env",
      "type": "adsr",
      "config": { "attack": 0.005, "decay": 0.08, "sustain": 0.2, "release": 0.12 }
    },
    {
      "id": "osc",
      "type": "oscillator",
      "config": { "frequency": 110.0, "oscillator_type": "sine" }
    },
    { "id": "vca", "type": "vca" },
    { "id": "dac", "type": "dac" }
  ],
  "connections": [
    { "from": "clock", "from_port": "gate", "to": "env", "to_port": "gate" },
    { "from": "osc", "from_port": "audio", "to": "vca", "to_port": "audio" },
    { "from": "env", "from_port": "envelope", "to": "vca", "to_port": "cv" },
    { "from": "vca", "from_port": "audio", "to": "dac", "to_port": "audio" }
  ]
}
